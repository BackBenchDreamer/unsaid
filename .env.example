# Environment variables for UnSaid.
# Copy to .env and fill in your Supabase project values.
# Never commit the actual .env file.

# ── Required ─────────────────────────────────────────────────────────────────

# Your Supabase project URL (find it in Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — safe to expose to the browser (RLS enforces access)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
